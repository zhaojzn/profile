# Copy to .env.local for the local preview. Do not use VITE_ prefixes:
# these values are read on the server, never bundled into the browser.
LASTFM_USERNAME=definemore
LASTFM_API_KEY=

# Optional: use Spotify's matching album cover and a direct track link.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
